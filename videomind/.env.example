# Required for article synthesis and chat
MISTRAL_API_KEY=your_mistral_key_here
# Optional: enables HydraDB semantic memory and cross-video search
HYDRADB_API_KEY=your_hydradb_key_here

# Optional overrides
# MISTRAL_MODEL=mistral-small-latest
# WHISPER_MODEL=base
# Relative SQLite paths and UPLOAD_FOLDER are stored inside DATA_DIR (default: videomind/instance)
DATABASE_URL=sqlite:///videomind.db
# DATA_DIR=instance
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000

# Optional: YouTube blocks caption requests from most cloud IPs (Render, AWS, ...).
# Route them through a proxy — Webshare residential proxies, or any HTTP(S) proxy URL.
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# YOUTUBE_PROXY_URL=http://user:pass@host:port
